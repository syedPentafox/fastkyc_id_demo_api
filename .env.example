# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/dbname

# Amazon S3 Configuration
AMAZON_S3_BASE_URL=https://example.cloudfront.net
S3_BUCKET_NAME=example-bucket

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-a-strong-random-key
ACCESS_TOKEN_EXPIRE_HOURS=240
REFRESH_TOKEN_EXPIRE_HOURS=240

# AES Encryption
AES_SECRET_KEY=your-aes-secret-key-here-32-characters-minimum

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
LOCALLY_SAVE_FILE=NO

# Admin Credentials
ADMIN_CLIENT_ID=admin
ADMIN_CLIENT_KEY=admin

# API Configuration
API_URL=http://127.0.0.1:5000

# Master Data (Optional)
MASTER_DATA_FOLDER_PATH=./orm_model/sample_data
